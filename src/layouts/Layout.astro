---
export interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Catálogo de Bodas — Invitaciones Elegantes',
  description = 'Descubre nuestra colección de invitaciones y papelería para bodas. Diseños únicos, elegantes y personalizados para tu día especial.',
} = Astro.props;

// URL absoluta del sitio y de la portada (WhatsApp/Facebook exigen ruta completa)
const base = Astro.site ?? Astro.url;
const urlPagina = new URL(Astro.url.pathname, base).href;
const urlPortada = new URL('/images/og-image.jpg', base).href;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={urlPagina} />

    <!-- Vista previa al compartir el link (WhatsApp, Facebook, Instagram, Telegram) -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content="Shop Invitaciones" />
    <meta property="og:url" content={urlPagina} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={urlPortada} />
    <meta property="og:image:secure_url" content={urlPortada} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Catálogo de invitaciones digitales para bodas" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={urlPortada} />

    <!-- Fuentes (carga rápida con preconnect) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet"
          href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Raleway:wght@300;400;500;600;700;800&family=Playfair+Display:ital,wght@0,400;0,600;1,400;1,600&family=Outfit:wght@300;400;500;600;700;800&display=swap" />
  </head>
  <body>
    <slot />
  </body>
</html>
