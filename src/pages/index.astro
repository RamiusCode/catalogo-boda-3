---
import Layout        from '../layouts/Layout.astro';
import Navbar        from '../components/Navbar.astro';
import QuienesSomos  from '../components/QuienesSomos.astro';
import CardGrid      from '../components/CardGrid.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import Footer        from '../components/Footer.astro';
import '../styles/global.css';

// ── Cambia estos datos por los tuyos ─────────────────────────────────────────
const WA_NUMERO = '59178762918';   // Bolivia +591 78762918 (sin + ni espacios)

// Cada modelo muestra solo su tag (ej. "Modelo 01"). Para ponerle un nombre,
// agrega:  nombre: 'Floral Rosa',  en el modelo que quieras.
const modelos = [
  { tag: 'Modelo 01', precio: '250', imagen: '/images/modelo1.webp', linkEjemplo: 'https://boda-modelo.vercel.app/',  linkDetalles: 'TU-LINK-DETALLES-01' },
  { tag: 'Modelo 02', precio: '250', imagen: '/images/modelo2.webp', linkEjemplo: 'https://modelo4-boda.vercel.app/', linkDetalles: 'TU-LINK-DETALLES-02' },
  { tag: 'Modelo 03', precio: '250', imagen: '/images/modelo3.webp', linkEjemplo: 'https://boda-modelo2.vercel.app/', linkDetalles: 'TU-LINK-DETALLES-03' },
  { tag: 'Modelo 04', precio: '250', imagen: '/images/modelo4.webp', linkEjemplo: 'https://modelo7-boda.vercel.app/',  linkDetalles: 'TU-LINK-DETALLES-04' },
  { tag: 'Modelo 05', precio: '250', imagen: '/images/modelo5.webp', linkEjemplo: 'https://modelo6-boda.vercel.app/',  linkDetalles: 'TU-LINK-DETALLES-05' },
  { tag: 'Modelo 06', precio: '250', imagen: '/images/modelo6.webp', linkEjemplo: 'https://modelo11-boda.vercel.app/',  linkDetalles: 'TU-LINK-DETALLES-06' },
  { tag: 'Modelo 07', precio: '250', imagen: '/images/modelo7.webp', linkEjemplo: 'https://boda-modelo-25.vercel.app/',  linkDetalles: 'TU-LINK-DETALLES-07', badge: 'Nuevo', badgeType: 'gold' },
  { tag: 'Modelo 08', precio: '250', imagen: '/images/modelo8.webp', linkEjemplo: 'https://boda-modelo-26.vercel.app/',  linkDetalles: 'TU-LINK-DETALLES-08', badge: 'Nuevo', badgeType: 'gold' },
  { tag: 'Modelo 09', precio: '250', imagen: '/images/modelo9.webp', linkEjemplo: 'https://boda-modelo-27.vercel.app/',  linkDetalles: 'TU-LINK-DETALLES-09', badge: 'Nuevo', badgeType: 'gold' },
  { tag: 'Modelo 10', precio: '250', imagen: '/images/modelo10.webp', linkEjemplo: 'https://boda-modelo-28.vercel.app/',  linkDetalles: 'TU-LINK-DETALLES-10', badge: 'Nuevo', badgeType: 'gold' },
  { tag: 'Modelo 11', precio: '250', imagen: '/images/modelo11.webp', linkEjemplo: 'https://boda-modelo-29.vercel.app/',  linkDetalles: 'TU-LINK-DETALLES-11', badge: 'Nuevo', badgeType: 'gold' },
];
// ─────────────────────────────────────────────────────────────────────────────
---

<Layout title="Catálogo de Invitaciones Digitales">
  <Navbar waNumero={WA_NUMERO} />
  <main>
    <CardGrid modelos={modelos} waNumero={WA_NUMERO} />
    <QuienesSomos />
  </main>
  <Footer />
  <WhatsAppFloat waNumero={WA_NUMERO} />
</Layout>
